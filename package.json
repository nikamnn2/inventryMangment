{
  "name": "inventry-mangment",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/install-server.cjs",
    "start": "ng serve",
    "start:mobile": "ng serve --host 0.0.0.0 --ssl --allowed-hosts 172.20.10.7",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "api:prod": "npm --prefix server run start:prod",
    "web:prod": "node dist/inventry-mangment/server/server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "api": "npm --prefix server start",
    "api:demo": "npm --prefix server run dev:memory",
    "serve:ssr:inventryMangment": "node dist/inventry-mangment/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/build": "^21.2.31",
    "@angular/cli": "^21.2.31",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/ssr": "^21.2.31",
    "@types/express": "^4.17.17",
    "@types/node": "^22.20.7",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "express": "^4.18.2",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "glob@^13": "^14.0.2",
    "minimatch@^10": "^11.0.2",
    "uuid@<11.1.1": "^11.1.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
