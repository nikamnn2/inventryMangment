{
  "name": "invenza-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB API for the Invenza aluminium & glass inventory system",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/server.js --prod",
    "seed:prod": "node scripts/seed.js --prod",
    "mail:test": "node scripts/mail-test.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=85 tests/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0"
  }
}
