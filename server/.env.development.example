# Development. Copy to .env.development (values here take priority over .env).
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=invenza_dev
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
JWT_SECRET=dev-only-secret
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:4200
ADMIN_EMAIL=admin@invenza.com
ADMIN_PASSWORD=aluminium

# 1 = no login needed (match authDisabled in src/environments/environment.ts)
AUTH_DISABLED=0

# demo manager@ / accountant@invenza.com users
SEED_DEMO_USERS=0
DEMO_USERS_PASSWORD=ChangeMe123

# leave SMTP_HOST empty to print activation links in the server log
APP_URL=http://localhost:4200
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Invenza <no-reply@yourcompany.com>
ACTIVATION_HOURS=48
