PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=invenza
# connection pool (shared by all requests)
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:4200
ADMIN_EMAIL=admin@invenza.com
ADMIN_PASSWORD=aluminium

# TEMPORARY: 1 = no login needed
AUTH_DISABLED=0

# demo manager@ / accountant@invenza.com users (1 = create them; off by default)
SEED_DEMO_USERS=0
DEMO_USERS_PASSWORD=ChangeMe123

# activation emails (leave SMTP_HOST empty to print the activation link in the server log)
APP_URL=http://localhost:4200
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Invenza <no-reply@yourcompany.com>
ACTIVATION_HOURS=48
