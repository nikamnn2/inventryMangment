# Production. Copy to .env.production and fill in the blanks. Never commit that file.
# Real environment variables (set by your host) take priority over this file.
PORT=3000
MONGODB_URI=
MONGODB_DB=invenza_prod
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
# at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# public address of the web app, e.g. https://inventory.yourcompany.com
CORS_ORIGIN=
APP_URL=
# first admin account; the password needs at least 12 characters
ADMIN_EMAIL=
ADMIN_PASSWORD=

# these must stay 0 in production
AUTH_DISABLED=0
SEED_DEMO_USERS=0
ENABLE_TEST_ROUTES=0

# required: every registration emails an activation link. Test with: npm run mail:test -- you@example.com --prod
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASS=a Google "app password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Invenza <no-reply@yourcompany.com>
ACTIVATION_HOURS=48
